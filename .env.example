# Copy to .env for local development. Never commit real secrets.

# Runtime
RAA_PROFILE=core
RAA_LOG_LEVEL=INFO
RAA_LOG_JSON=false

# Workspace and database. Relative paths resolve from the current directory.
RAA_WORKSPACE=.raa-workspace

# REST API
RAA_API_HOST=127.0.0.1
RAA_API_PORT=8765
# RAA_API_TOKEN=replace-me

# Input safety
# JSON array of absolute directories that artifact_ingest may read from.
# RAA_ALLOWED_INPUT_ROOTS=["C:\\Users\\me\\samples"]

# Limits
RAA_MAX_INPUT_BYTES=2147483648
RAA_MAX_ARCHIVE_ENTRIES=50000
RAA_MAX_UNCOMPRESSED_BYTES=8589934592
RAA_MAX_MANIFEST_BYTES=4194304
